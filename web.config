<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración para servidores Windows (IIS). En Apache se ignora. -->
<configuration>
  <system.webServer>
    <defaultDocument><files><clear/><add value="index.html"/></files></defaultDocument>
    <staticContent>
      <remove fileExtension=".webp"/><mimeMap fileExtension=".webp" mimeType="image/webp"/>
      <remove fileExtension=".webmanifest"/><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json"/>
    </staticContent>
  </system.webServer>
</configuration>
